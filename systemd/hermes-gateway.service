[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/opt/hermes-agent/current/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=%h/.hermes
Environment=PATH=%h/.local/opt/hermes-agent/current/venv/bin:%h/.local/opt/hermes-agent/current/source/node_modules/.bin:%h/.hermes/node/bin:%h/.hermes/node:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=VIRTUAL_ENV=%h/.local/opt/hermes-agent/current/venv
Environment=HERMES_HOME=%h/.hermes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
MemoryHigh=1G
MemoryMax=2G
TasksMax=256
CPUWeight=100
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-%h/.local/opt/hermes-agent/current/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStartSec=60
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
