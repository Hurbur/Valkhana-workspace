{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Valkhana",
  "version": "0.1.0",
  "identifier": "com.hurbur.valkhana",
  "build": {
    "frontendDist": "http://127.0.0.1:3000",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm tauri:prepare"
  },
  "app": {
    "windows": [
      {
        "title": "Valkhana",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/valkhana-web"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
